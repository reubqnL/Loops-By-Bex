# Application settings
APP_ENV=production
APP_URL=https://loopsbybex.co.uk
# Modes: "live" (full website at /, /launching redirects to /), "launching" (waitlist at /), or "preview" (both accessible)
APP_LAUNCHING_MODE=preview

# MySQL Database (IONOS or local)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=loops_by_bex
DB_USER=your_db_username
DB_PASS=your_db_password
# Optional path to CA bundle if your MySQL host requires explicit TLS verification
DB_SSL_CA=

# Payment Gateway (Stripe Hosted Checkout — raw card details never touch this server)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Brand & Contact links
CONTACT_EMAIL=hello@loopsbybex.co.uk
INSTAGRAM_URL=https://www.instagram.com/bex2_011/
ETSY_SHOP_URL=
