Options -Indexes -MultiViews
ServerSignature Off
RewriteEngine On
RewriteBase /

ErrorDocument 404 /pages/404.php

# block direct access to .env, all hidden dotfiles (except .well-known for ssl), backend folders and source files
RewriteRule (^|/)\.env - [F,L,NC]
RewriteRule (^|/)\.(?!well-known(/|$)) - [F,L,NC]
RewriteRule ^(config\.php|router\.php|includes(/.*)?|partials(/.*)?|database(/.*)?|vendor(/.*)?|storage(/.*)?|composer\.(json|lock)|LICENSE|README\.md|assets/wireframe\.png)$ - [F,L,NC]
RewriteRule \.(scss|map|sql|sqlite|sqlite3|db|log|env|bak|sh|md)$ - [F,L,NC]

# force https + non-www on live domain
RewriteCond %{HTTP_HOST} ^(www\.)?loopsbybex\.co\.uk$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://loopsbybex.co.uk%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTP_HOST} ^www\.loopsbybex\.co\.uk$ [NC]
RewriteRule ^ https://loopsbybex.co.uk%{REQUEST_URI} [R=301,L]

# uncomment when deleting launching files after launch
# RewriteRule ^(pages/)?(launching|launchingty)(\.php)?$ / [R=301,L,QSD]
# RewriteRule ^process-waitlist(\.php)?$ / [R=301,L,QSD]

# clean up /index and /pages/*.php on get requests only (dont touch post endpoints)
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
RewriteCond %{THE_REQUEST} \s/(pages/)?index(\.php)?[\s?] [NC]
RewriteRule ^(pages/)?index(\.php)?$ / [R=301,L]

RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
RewriteCond %{THE_REQUEST} \s/pages/([a-zA-Z0-9_-]+)\.php[\s?] [NC]
RewriteRule ^pages/([a-zA-Z0-9_-]+)\.php$ /%1 [R=301,L]

RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
RewriteCond %{THE_REQUEST} \s/sitemap\.php[\s?] [NC]
RewriteRule ^sitemap\.php$ /sitemap.xml [R=301,L]

RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^$ pages/index.php [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/pages/$1.php -f
RewriteRule ^([a-zA-Z0-9_-]+)$ pages/$1.php [L,QSA]

<Files ".env">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

<FilesMatch "^(\.env.*|\.git.*|composer\.(json|lock)|LICENSE|README\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), usb=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>
