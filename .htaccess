# Enable Rewrite Engine
RewriteEngine On

# Redirect external .php requests to extensionless URLs
RewriteCond %{THE_REQUEST} ^[A-Z]{3,7}\s+/pages/([^\s\.]+)\.php [NC]
RewriteRule ^pages/([^\s\.]+)\.php$ /%1 [R=301,L]

# Map clean URLs to files inside the pages folder (matching /launching to pages/launching.php)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/pages/$1.php -f
RewriteRule ^([a-zA-Z0-9_-]+)$ pages/$1.php [L]

# Silently serve pages/launching.php when visiting loopsbybex.co.uk or www.loopsbybex.co.uk
RewriteCond %{HTTP_HOST} ^(www\.)?loopsbybex\.co\.uk$ [NC]
RewriteCond %{REQUEST_URI} ^/?$
RewriteRule ^$ pages/launching.php [L]

# Disable directory browsing (prevents users from seeing folder file lists)
Options -Indexes

# Protect .env configuration file
<Files .env>
    Order allow,deny
    Deny from all
</Files>

# Protect system dotfiles (excluding .htaccess)
<FilesMatch "^\.(?!htaccess)">
    Order allow,deny
    Deny from all
</FilesMatch>

# Prevent direct access to composer files
<FilesMatch "^(composer\.json|composer\.lock)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Enable HTTP Security Headers
<IfModule mod_headers.c>
    # Protect against MIME type sniffing
    Header set X-Content-Type-Options "nosniff"

    # Enable XSS protection in legacy browsers
    Header set X-XSS-Protection "1; mode=block"

    # Prevent clickjacking by restricting framing
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>